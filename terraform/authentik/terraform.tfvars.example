authentik_url   = "https://auth.mauzlab.de"
authentik_token = "your-authentik-api-token"

# Optional: set this when importing an existing Grafana OAuth provider.
# Leave unset to let Authentik generate its secret.
# grafana_oauth_client_secret = "existing-grafana-client-secret"

# Optional: set this when importing an existing Paperless-ngx OAuth provider.
# Leave unset to let Authentik generate its secret.
# paperless_oauth_client_secret = "existing-paperless-client-secret"

# Optional: set this when importing an existing Immich OAuth provider.
# Leave unset to let Authentik generate its secret.
# immich_oauth_client_secret = "existing-immich-client-secret"

# Optional: set this when importing an existing Argo CD OAuth provider.
# Leave unset to let Authentik generate its secret.
# argocd_oauth_client_secret = "existing-argocd-client-secret"

# Optional: set this when importing an existing Planka OAuth provider.
# Leave unset to let Authentik generate its secret.
# planka_oauth_client_secret = "existing-planka-client-secret"
